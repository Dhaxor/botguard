{
  "name": "botguard",
  "version": "0.1.0",
  "description": "Scan crypto trading-bot repos, npm/PyPI packages and Solidity contracts for malware and wallet drainers. Includes a Claude Code hook that blocks malicious installs.",
  "keywords": [
    "security",
    "malware",
    "supply-chain",
    "typosquatting",
    "crypto",
    "trading-bot",
    "polymarket",
    "solidity",
    "wallet-drainer",
    "claude-code"
  ],
  "type": "module",
  "bin": {
    "botguard": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs cli"
  },
  "devDependencies": {
    "@botguard/core": "0.1.0"
  },
  "dependencies": {
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "fflate": "^0.8.2",
    "picocolors": "^1.1.1",
    "semver": "^7.7.0",
    "solc": "^0.8.30"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dhaxor/botguard.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Dhaxor/botguard#readme",
  "bugs": "https://github.com/Dhaxor/botguard/issues",
  "license": "MIT"
}
